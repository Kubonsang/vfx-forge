{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://github.com/Kubonsang/vfx-forge/schemas/vfx-mesh-reference-1.0.schema.json",
  "title": "VFX Forge Mesh Reference 1.0",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schemaVersion",
    "taskId",
    "selectedCandidateId",
    "candidateBoardPath",
    "candidateBoardSha256",
    "modelSheetPath",
    "modelSheetSha256",
    "unityUnitsPerMeter",
    "views",
    "landmarks",
    "parts"
  ],
  "properties": {
    "schemaVersion": { "const": "mesh-reference-1.0" },
    "taskId": { "type": "string", "pattern": "^VF-[0-9]{3}$" },
    "selectedCandidateId": { "type": "string" },
    "candidateBoardPath": { "type": "string" },
    "candidateBoardSha256": { "$ref": "#/$defs/sha256" },
    "modelSheetPath": { "type": "string" },
    "modelSheetSha256": { "$ref": "#/$defs/sha256" },
    "unityUnitsPerMeter": { "type": "number", "exclusiveMinimum": 0 },
    "views": {
      "type": "array",
      "minItems": 4,
      "maxItems": 4,
      "items": { "$ref": "#/$defs/view" }
    },
    "landmarks": {
      "type": "array",
      "minItems": 1,
      "items": { "$ref": "#/$defs/landmark" }
    },
    "parts": {
      "type": "array",
      "minItems": 6,
      "items": { "$ref": "#/$defs/part" }
    }
  },
  "$defs": {
    "sha256": { "type": "string", "pattern": "^[a-f0-9]{64}$" },
    "vector2": {
      "type": "object",
      "additionalProperties": false,
      "required": ["x", "y"],
      "properties": {
        "x": { "type": "number" },
        "y": { "type": "number" }
      }
    },
    "vector3": {
      "type": "object",
      "additionalProperties": false,
      "required": ["x", "y", "z"],
      "properties": {
        "x": { "type": "number" },
        "y": { "type": "number" },
        "z": { "type": "number" }
      }
    },
    "rect": {
      "type": "object",
      "additionalProperties": false,
      "required": ["x", "y", "width", "height"],
      "properties": {
        "x": { "type": "number", "minimum": 0, "maximum": 1 },
        "y": { "type": "number", "minimum": 0, "maximum": 1 },
        "width": { "type": "number", "exclusiveMinimum": 0, "maximum": 1 },
        "height": { "type": "number", "exclusiveMinimum": 0, "maximum": 1 }
      }
    },
    "view": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "id",
        "projection",
        "width",
        "height",
        "position",
        "target",
        "rotationEuler",
        "fieldOfView",
        "orthographicSize",
        "normalizedImageRect"
      ],
      "properties": {
        "id": { "enum": ["front", "top", "right_side", "gameplay"] },
        "projection": { "enum": ["orthographic", "perspective"] },
        "width": { "type": "integer", "minimum": 1 },
        "height": { "type": "integer", "minimum": 1 },
        "position": { "$ref": "#/$defs/vector3" },
        "target": { "$ref": "#/$defs/vector3" },
        "rotationEuler": { "$ref": "#/$defs/vector3" },
        "fieldOfView": { "type": "number", "minimum": 0, "exclusiveMaximum": 180 },
        "orthographicSize": { "type": "number", "minimum": 0 },
        "normalizedImageRect": { "$ref": "#/$defs/rect" }
      }
    },
    "landmark": {
      "type": "object",
      "additionalProperties": false,
      "required": ["id", "viewId", "partId", "normalizedPosition", "depthMeters"],
      "properties": {
        "id": { "type": "string" },
        "viewId": { "type": "string" },
        "partId": { "type": "string" },
        "normalizedPosition": { "$ref": "#/$defs/vector2" },
        "depthMeters": { "type": "number" }
      }
    },
    "part": {
      "type": "object",
      "additionalProperties": false,
      "required": ["id", "role", "materialZone", "connectedTo"],
      "properties": {
        "id": { "type": "string" },
        "role": { "type": "string" },
        "materialZone": { "type": "string" },
        "connectedTo": { "type": "array", "items": { "type": "string" } }
      }
    }
  }
}
