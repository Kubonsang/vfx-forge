{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://github.com/Kubonsang/vfx-forge/schemas/vfx-concept-candidates-1.0.schema.json",
  "title": "VFX Forge Concept Candidates 1.0",
  "type": "object",
  "additionalProperties": false,
  "required": ["schemaVersion", "taskId", "referenceBoardSha256", "artDirectionBriefSha256", "promptSetPath", "promptSetSha256", "generator", "candidates"],
  "properties": {
    "schemaVersion": { "const": "concept-candidates-1.0" },
    "taskId": { "type": "string", "pattern": "^VF-[0-9]{3}$" },
    "referenceBoardSha256": { "$ref": "#/$defs/sha256" },
    "artDirectionBriefSha256": { "$ref": "#/$defs/sha256" },
    "promptSetPath": { "type": "string", "minLength": 1 },
    "promptSetSha256": { "$ref": "#/$defs/sha256" },
    "generator": { "type": "string", "minLength": 1 },
    "candidates": {
      "type": "array",
      "minItems": 3,
      "maxItems": 6,
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": ["id", "title", "boardPath", "boardSha256", "cameraView", "width", "height", "effectFootprintPixels", "evidence", "shapeSummary", "knownRisks"],
        "properties": {
          "id": { "type": "string", "pattern": "^[a-z0-9][a-z0-9_-]{2,63}$" },
          "title": { "type": "string", "minLength": 1 },
          "boardPath": { "type": "string", "minLength": 1 },
          "boardSha256": { "$ref": "#/$defs/sha256" },
          "cameraView": { "const": "strict_top_down" },
          "width": { "type": "integer", "minimum": 1 },
          "height": { "type": "integer", "minimum": 1 },
          "effectFootprintPixels": { "type": "integer", "minimum": 1 },
          "evidence": {
            "type": "array",
            "minItems": 4,
            "maxItems": 4,
            "uniqueItems": true,
            "items": {
              "enum": ["grayscale_silhouette", "full_color_concept", "three_ground_composite", "labeled_breakdown"]
            }
          },
          "shapeSummary": { "type": "string", "minLength": 1 },
          "knownRisks": {
            "type": "array",
            "minItems": 1,
            "items": { "type": "string", "minLength": 1 }
          }
        }
      }
    }
  },
  "$defs": {
    "sha256": { "type": "string", "pattern": "^[a-fA-F0-9]{64}$" }
  }
}
