{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://kubonsang.dev/schemas/vfx-forge-recipe-1.1.schema.json",
  "title": "VFX Forge Recipe 1.1",
  "type": "object",
  "required": ["schemaVersion", "id", "template", "outputPath", "timing", "budget"],
  "properties": {
    "schemaVersion": { "const": "1.1" },
    "id": {
      "type": "string",
      "pattern": "^[a-z0-9][a-z0-9_-]{2,63}$"
    },
    "displayName": { "type": "string", "default": "" },
    "template": { "type": "string", "minLength": 1 },
    "styleProfile": { "type": "string", "default": "" },
    "intent": { "type": "string", "default": "" },
    "outputPath": {
      "type": "string",
      "pattern": "^Assets[\\\\/](?!\\.\\.(?:[\\\\/]|$))(?!.*[\\\\/]\\.\\.(?:[\\\\/]|$))(?!.*[\\\\/]{2})[^:]+\\.prefab$"
    },
    "anchor": { "type": "string", "default": "HitPoint" },
    "seed": { "type": "integer", "default": 1 },
    "timing": {
      "type": "object",
      "required": ["duration"],
      "properties": {
        "duration": { "type": "number", "exclusiveMinimum": 0 },
        "anticipation": { "type": "number", "minimum": 0, "default": 0 },
        "impact": { "type": "number", "minimum": 0, "default": 0.1 },
        "sustain": { "type": "number", "minimum": 0, "default": 0.1 },
        "decay": { "type": "number", "minimum": 0, "default": 0.3 }
      },
      "additionalProperties": false
    },
    "shape": {
      "type": "object",
      "default": {},
      "properties": {
        "radius": { "type": "number", "minimum": 0, "default": 1 },
        "directionality": {
          "type": "number",
          "minimum": 0,
          "maximum": 1,
          "default": 0
        },
        "spreadAngle": {
          "type": "number",
          "minimum": 0,
          "maximum": 360,
          "default": 45
        }
      },
      "additionalProperties": false
    },
    "style": {
      "type": "object",
      "default": {},
      "properties": {
        "primaryColor": {
          "type": "string",
          "pattern": "^#[0-9A-Fa-f]{6}([0-9A-Fa-f]{2})?$",
          "default": "#FFFFFFFF"
        },
        "secondaryColor": {
          "type": "string",
          "pattern": "^#[0-9A-Fa-f]{6}([0-9A-Fa-f]{2})?$",
          "default": "#FFFFFFFF"
        },
        "emissionIntensity": {
          "type": "number",
          "minimum": 0,
          "default": 1
        },
        "sharpness": {
          "type": "number",
          "minimum": 0,
          "maximum": 1,
          "default": 0.5
        },
        "distortionStrength": {
          "type": "number",
          "minimum": 0,
          "default": 0
        }
      },
      "additionalProperties": false
    },
    "motion": {
      "type": "object",
      "default": {},
      "properties": {
        "speed": { "type": "number", "minimum": 0, "default": 0 },
        "localDirection": {
          "type": "object",
          "default": { "x": 0, "y": 0, "z": 1 },
          "required": ["x", "y", "z"],
          "properties": {
            "x": { "type": "number" },
            "y": { "type": "number" },
            "z": { "type": "number" }
          },
          "additionalProperties": false
        }
      },
      "additionalProperties": false
    },
    "geometry": {
      "type": "object",
      "default": {},
      "properties": {
        "variant": { "type": "string", "default": "" }
      },
      "additionalProperties": false
    },
    "layers": {
      "type": "array",
      "default": [],
      "items": { "type": "string", "minLength": 1 },
      "uniqueItems": true
    },
    "budget": {
      "type": "object",
      "required": ["maxParticles", "maxDuration"],
      "properties": {
        "maxParticles": { "type": "integer", "minimum": 1 },
        "maxDuration": { "type": "number", "exclusiveMinimum": 0 },
        "maxBoundsRadius": {
          "type": "number",
          "exclusiveMinimum": 0,
          "default": 5
        },
        "allowDistortion": { "type": "boolean", "default": false },
        "allowLight": { "type": "boolean", "default": false }
      },
      "additionalProperties": false
    },
    "capture": {
      "type": "object",
      "default": {},
      "properties": {
        "duration": { "type": "number", "exclusiveMinimum": 0, "default": 1 },
        "frameTimes": {
          "type": "array",
          "default": [0, 0.1, 0.2, 0.5, 1],
          "items": { "type": "number", "minimum": 0 }
        },
        "views": {
          "type": "array",
          "default": ["front"],
          "items": { "enum": ["front", "side", "top"] },
          "uniqueItems": true
        },
        "contexts": {
          "type": "array",
          "default": [],
          "items": {
            "type": "string",
            "pattern": "^[a-z0-9][a-z0-9_-]{2,63}$"
          },
          "uniqueItems": true
        },
        "width": { "type": "integer", "minimum": 64, "default": 1024 },
        "height": { "type": "integer", "minimum": 64, "default": 1024 }
      },
      "additionalProperties": false
    },
    "quality": {
      "type": "object",
      "default": {},
      "properties": {
        "minimumForegroundRatio": {
          "type": "number",
          "minimum": 0,
          "maximum": 1,
          "default": 0.01
        },
        "maximumBorderForegroundRatio": {
          "type": "number",
          "minimum": 0,
          "maximum": 1,
          "default": 0.005
        },
        "requireHumanReview": { "type": "boolean", "default": false }
      },
      "additionalProperties": false
    }
  },
  "additionalProperties": false
}
