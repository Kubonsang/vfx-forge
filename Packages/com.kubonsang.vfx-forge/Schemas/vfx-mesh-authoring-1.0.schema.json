{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://github.com/Kubonsang/vfx-forge/schemas/vfx-mesh-authoring-1.0.schema.json",
  "title": "VFX Forge Mesh Authoring 1.0",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schemaVersion",
    "taskId",
    "meshReferenceSha256",
    "sourcePrefabPath",
    "sourceDependencyHash",
    "runtimePrefabPath",
    "runtimeDependencyHash",
    "runtimeMeshFolder",
    "renderedTriangles",
    "maximumRenderedTriangles",
    "materialZones"
  ],
  "properties": {
    "schemaVersion": { "const": "mesh-authoring-1.0" },
    "taskId": { "type": "string", "pattern": "^VF-[0-9]{3}$" },
    "meshReferenceSha256": { "$ref": "#/$defs/sha256" },
    "sourcePrefabPath": { "type": "string", "pattern": "^Assets/.+\\.prefab$" },
    "sourceDependencyHash": { "type": "string" },
    "runtimePrefabPath": { "type": "string", "pattern": "^Assets/.+\\.prefab$" },
    "runtimeDependencyHash": { "type": "string" },
    "runtimeMeshFolder": { "type": "string", "pattern": "^Assets/" },
    "renderedTriangles": { "type": "integer", "minimum": 0 },
    "maximumRenderedTriangles": { "type": "integer", "minimum": 1 },
    "materialZones": { "type": "array", "items": { "type": "string" } }
  },
  "$defs": {
    "sha256": { "type": "string", "pattern": "^[a-f0-9]{64}$" }
  }
}
