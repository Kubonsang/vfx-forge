{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://github.com/Kubonsang/vfx-forge/schemas/vfx-reference-board-1.0.schema.json",
  "title": "VFX Forge Reference Board 1.0",
  "type": "object",
  "additionalProperties": false,
  "required": ["schemaVersion", "id", "taskId", "title", "references", "styleGoals", "globalAvoids"],
  "properties": {
    "schemaVersion": { "const": "reference-board-1.0" },
    "id": { "$ref": "#/$defs/id" },
    "taskId": { "type": "string", "pattern": "^VF-[0-9]{3}$" },
    "title": { "type": "string", "minLength": 1 },
    "references": {
      "type": "array",
      "minItems": 1,
      "items": { "$ref": "#/$defs/reference" }
    },
    "styleGoals": { "$ref": "#/$defs/nonEmptyStrings" },
    "globalAvoids": { "$ref": "#/$defs/nonEmptyStrings" }
  },
  "$defs": {
    "id": {
      "type": "string",
      "pattern": "^[a-z0-9][a-z0-9_-]{2,63}$"
    },
    "nonEmptyStrings": {
      "type": "array",
      "minItems": 1,
      "items": { "type": "string", "minLength": 1 }
    },
    "reference": {
      "type": "object",
      "additionalProperties": false,
      "required": ["id", "title", "sourceType", "source", "creator", "license", "usage", "desiredElements", "avoidElements", "frame", "notes"],
      "properties": {
        "id": { "$ref": "#/$defs/id" },
        "title": { "type": "string", "minLength": 1 },
        "sourceType": { "enum": ["url", "project_asset", "generated"] },
        "source": { "type": "string", "minLength": 1 },
        "creator": { "type": "string", "minLength": 1 },
        "license": { "type": "string", "minLength": 1 },
        "usage": { "enum": ["inspiration_only", "redistributable", "generated_owned"] },
        "desiredElements": { "$ref": "#/$defs/nonEmptyStrings" },
        "avoidElements": { "$ref": "#/$defs/nonEmptyStrings" },
        "frame": {
          "type": "object",
          "additionalProperties": false,
          "required": ["cameraAngle", "cropFocus"],
          "properties": {
            "cameraAngle": { "type": "string", "minLength": 1 },
            "cropFocus": { "type": "string", "minLength": 1 }
          }
        },
        "notes": { "type": "string" }
      }
    }
  }
}
